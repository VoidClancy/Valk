{{- range $enum := .Schema.Enums }}
// {{ $enum.Name }}Type represents the "{{ $enum.Name }}" enum in the schema.
//
// Values:
{{- $maxVal := 0 }}{{ range $v := $enum.ValueMap }}{{ $constName := printf "%s_%s" $enum.Name (uppercase $v.Name) }}{{ if gt (len $constName) $maxVal }}{{ $maxVal = len $constName }}{{ end }}{{ end }}
{{- range $v := $enum.ValueMap }}
//   {{ printf "%-*s" $maxVal (printf "%s_%s" $enum.Name (uppercase $v.Name)) }} -> "{{ $v.DBName }}"
{{- end }}
type {{ $enum.Name }}Type string

const (
	{{- range $val := $enum.ValueMap }}
	// {{ $enum.Name }}_{{ uppercase $val.Name }} maps to "{{ $val.DBName }}" in the database.
	{{ $enum.Name }}_{{ uppercase $val.Name }} {{ $enum.Name }}Type = "{{ $val.DBName }}"
	{{- end }}
)

// IsValid reports whether e is a valid {{ $enum.Name }}Type enum value.
func (e {{ $enum.Name }}Type) IsValid() bool {
	switch e {
	case {{ range $i, $val := $enum.ValueMap }}{{ if $i }}, {{ end }}{{ $enum.Name }}_{{ uppercase $val.Name }}{{ end }}:
		return true
	}
	return false
}
{{- end }}
