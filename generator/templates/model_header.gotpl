package {{ .PackageName }}

import (
	"context"
	"database/sql"
	{{- if hasModelType .Model "Json" }}
	"encoding/json"
	{{- end }}
	"fmt"
	"slices"
	"strings"
	{{- if hasModelType .Model "DateTime" }}
	"time"
	{{- end }}
	{{- if and (hasModelType .Model "Array") (isPostgresProvider .Schema) }}
	"github.com/lib/pq"
	{{- end }}
	{{- if ne .PackageName .ParentPackageName }}
	"{{ .ParentImportPath }}"
	{{- end }}
)

{{- if and (hasModelType .Model "Array") (isPostgresProvider .Schema) }}
var _ = pq.Array
{{- end }}

