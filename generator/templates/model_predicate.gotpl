package {{ .PackageName }}

import (
	"context"
	{{- if hasModelType .Model "Json" }}
	"encoding/json"
	{{- end }}
	{{- if hasModelType .Model "DateTime" }}
	"time"
	{{- end }}
	"{{ .ParentImportPath }}"
)

type Select = {{ .ParentPackageName }}.{{ .Model.Name }}Select
type Omit = {{ .ParentPackageName }}.{{ .Model.Name }}Omit
type QueryBuilder = {{ .ParentPackageName }}.{{ .Model.Name }}QueryBuilder
type CreateBuilder = {{ .ParentPackageName }}.{{ .Model.Name }}CreateBuilder
type Upsert = {{ .ParentPackageName }}.{{ .Model.Name }}Upsert
type ConflictBuilder[B any] = {{ .ParentPackageName }}.{{ .Model.Name }}ConflictBuilder[B]

func Query() *QueryBuilder {
	return &QueryBuilder{}
}

func Record(assignments ...{{ .ParentPackageName }}.FieldAssignmentOf[{{ .ParentPackageName }}.{{ .Model.Name }}]) {{ .ParentPackageName }}.RecordInput {
	raw := make([]{{ .ParentPackageName }}.FieldAssignment, len(assignments))
	for i, a := range assignments {
		raw[i] = {{ .ParentPackageName }}.FieldAssignment(a)
	}
	return {{ .ParentPackageName }}.RecordInput{Assignments: raw}
}

func And(preds ...{{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}]) {{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}] {
	return {{ .ParentPackageName }}.And(preds...)
}

func Or(preds ...{{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}]) {{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}] {
	return {{ .ParentPackageName }}.Or(preds...)
}

func Not(pred {{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}]) {{ .ParentPackageName }}.PredicateOf[{{ .ParentPackageName }}.{{ .Model.Name }}] {
	return {{ .ParentPackageName }}.Not(pred)
}

{{ range $field := .Model.ScalarFields -}}
{{- $isUnique := or $field.IsID $field.IsUnique -}}
{{- $fieldType := fieldPredType $field $.ParentPackageName -}}
{{- $col := $field.EffectiveColName -}}
{{- if $field.IsArray }}
	{{- $elemType := trimPrefix $fieldType "[]" }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.ArrayField[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $elemType }}]{Column: "{{ $col }}"}
{{- else if eq $field.Type "String" }}
	{{- if $field.Optional }}
		{{- if $isUnique }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.OptionalStringUniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{StringUniqueField: {{ $.ParentPackageName }}.StringUniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{Column: "{{ $col }}"}}
		{{- else }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.OptionalStringField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{StringField: {{ $.ParentPackageName }}.StringField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{Column: "{{ $col }}"}}
		{{- end }}
	{{- else }}
		{{- if $isUnique }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.StringUniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{Column: "{{ $col }}"}
		{{- else }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.StringField[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{Column: "{{ $col }}"}
		{{- end }}
	{{- end }}
{{- else }}
	{{- if $field.Optional }}
		{{- if $isUnique }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.OptionalUniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{UniqueField: {{ $.ParentPackageName }}.UniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{Column: "{{ $col }}"}}
		{{- else }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.OptionalField[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{Field: {{ $.ParentPackageName }}.Field[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{Column: "{{ $col }}"}}
		{{- end }}
	{{- else }}
		{{- if $isUnique }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.UniqueField[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{Column: "{{ $col }}"}
		{{- else }}
var {{ capitalize $field.Name }} = {{ $.ParentPackageName }}.Field[{{ $.ParentPackageName }}.{{ $.Model.Name }}, {{ $fieldType }}]{Column: "{{ $col }}"}
		{{- end }}
	{{- end }}
{{- end }}
{{ end }}

{{- range $index := .Model.CompositeUnique }}
{{- $constraintName := $index.Name }}
{{- if eq $constraintName "" }}
	{{- range $i, $f := $index.Fields }}
		{{- if $i }}
			{{- $constraintName = printf "%s_%s" $constraintName (capitalize $f) }}
		{{- else }}
			{{- $constraintName = capitalize $f }}
		{{- end }}
	{{- end }}
{{- end }}
type {{ lowercase $constraintName }} struct {
	{{ $.ParentPackageName }}.CompositeUniqueConstraint[{{ $.ParentPackageName }}.{{ $.Model.Name }}]
	Column string
}

var {{ capitalize $constraintName }} = {{ lowercase $constraintName }}{
	CompositeUniqueConstraint: {{ $.ParentPackageName }}.CompositeUniqueConstraint[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{
		Name:    "{{ $constraintName }}",
		Columns: []string{
			{{- range $fName := $index.Fields }}
			"{{ ($.Model.GetField $fName).EffectiveColName }}",
			{{- end }}
		},
	},
	Column: "{{ $constraintName }}",
}

func (f {{ lowercase $constraintName }}) EQ(
	{{- range $i, $fName := $index.Fields -}}
		{{- $field := $.Model.GetField $fName -}}
		{{- if $i }}, {{ end -}}
		{{- lowercase $field.Name }} {{ fieldPredType $field $.ParentPackageName -}}
	{{- end -}}
) {{ $.ParentPackageName }}.UniquePredicate[{{ $.ParentPackageName }}.{{ $.Model.Name }}] {
	return {{ $.ParentPackageName }}.UniquePredicate[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{
		Data: {{ $.ParentPackageName }}.PredicateData{
			Column:    "{{ $constraintName }}",
			Operator:  "AND",
			Value: map[string]any{
				{{- range $fName := $index.Fields }}
				{{- $field := $.Model.GetField $fName }}
				"{{ $field.EffectiveColName }}": {{ lowercase $field.Name }},
				{{- end }}
			},
			IsLogical: true,
			Children: []{{ $.ParentPackageName }}.PredicateData{
				{{- range $fName := $index.Fields }}
				{{- $field := $.Model.GetField $fName }}
				{Column: "{{ $field.EffectiveColName }}", Operator: "=", Value: {{ lowercase $field.Name }}},
				{{- end }}
			},
		},
	}
}
{{- end }}

{{- if .Model.CompositePK }}
{{- $pkDef := .Model.CompositePK }}
{{- $pkVarName := $pkDef.Name }}
{{- if eq $pkVarName "" }}
	{{- $pkVarName = "" }}
	{{- range $i, $f := $pkDef.Fields }}
		{{- if $i }}
			{{- $pkVarName = printf "%s_%s" $pkVarName (capitalize $f) }}
		{{- else }}
			{{- $pkVarName = capitalize $f }}
		{{- end }}
	{{- end }}
{{- end }}
type {{ lowercase $pkVarName }} struct {
	{{ $.ParentPackageName }}.CompositeUniqueConstraint[{{ $.ParentPackageName }}.{{ $.Model.Name }}]
	Column string
}

var {{ $pkVarName }} = {{ lowercase $pkVarName }}{
	CompositeUniqueConstraint: {{ $.ParentPackageName }}.CompositeUniqueConstraint[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{
		Name:    "{{ $pkVarName }}",
		Columns: []string{
			{{- range $fName := $pkDef.Fields }}
			"{{ ($.Model.GetField $fName).EffectiveColName }}",
			{{- end }}
		},
	},
	Column: "{{ $pkVarName }}",
}

func (f {{ lowercase $pkVarName }}) EQ(
	{{- range $i, $fName := $pkDef.Fields -}}
		{{- $field := $.Model.GetField $fName -}}
		{{- if $i }}, {{ end -}}
		{{- lowercase $field.Name }} {{ fieldPredType $field $.ParentPackageName -}}
	{{- end -}}
) {{ $.ParentPackageName }}.UniquePredicate[{{ $.ParentPackageName }}.{{ $.Model.Name }}] {
	return {{ $.ParentPackageName }}.UniquePredicate[{{ $.ParentPackageName }}.{{ $.Model.Name }}]{
		Data: {{ $.ParentPackageName }}.PredicateData{
			Column:    "{{ $pkVarName }}",
			Operator:  "AND",
			Value: map[string]any{
				{{- range $fName := $pkDef.Fields }}
				{{- $field := $.Model.GetField $fName }}
				"{{ $field.EffectiveColName }}": {{ lowercase $field.Name }},
				{{- end }}
			},
			IsLogical: true,
			Children: []{{ $.ParentPackageName }}.PredicateData{
				{{- range $fName := $pkDef.Fields }}
				{{- $field := $.Model.GetField $fName }}
				{Column: "{{ $field.EffectiveColName }}", Operator: "=", Value: {{ lowercase $field.Name }}},
				{{- end }}
			},
		},
	}
}
{{- end }}

type CreateInput = {{ $.ParentPackageName }}.{{ $.Model.Name }}Create
