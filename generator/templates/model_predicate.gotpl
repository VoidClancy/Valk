type CreateManyArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}CreateManyArgs
type CreateManyAndReturnArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}CreateManyAndReturnArgs

type CreateQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}CreateQuery
type CreateHook = func(context.Context, *CreateArgs, CreateQuery) (*{{ $.ParentPackageName }}.{{ $.Model.Name }}, error)

type CreateManyQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}CreateManyQuery
type CreateManyHook = func(context.Context, *CreateManyArgs, CreateManyQuery) (int64, error)

type CreateManyAndReturnQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}CreateManyAndReturnQuery
type CreateManyAndReturnHook = func(context.Context, *CreateManyAndReturnArgs, CreateManyAndReturnQuery) ([]*{{ $.ParentPackageName }}.{{ $.Model.Name }}, error)

type FindUniqueArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindUniqueArgs
type FindUniqueQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindUniqueQuery
type FindUniqueHook = func(context.Context, *FindUniqueArgs, FindUniqueQuery) (*{{ $.ParentPackageName }}.{{ $.Model.Name }}, error)

type FindFirstArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindFirstArgs
type FindFirstQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindFirstQuery
type FindFirstHook = func(context.Context, *FindFirstArgs, FindFirstQuery) (*{{ $.ParentPackageName }}.{{ $.Model.Name }}, error)

type FindManyArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindManyArgs
type FindManyQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}FindManyQuery
type FindManyHook = func(context.Context, *FindManyArgs, FindManyQuery) ([]*{{ $.ParentPackageName }}.{{ $.Model.Name }}, error)

type CountArgs = {{ $.ParentPackageName }}.{{ $.Model.Name }}CountArgs
type CountQuery = {{ $.ParentPackageName }}.{{ $.Model.Name }}CountQuery
type CountHook = func(context.Context, *CountArgs, CountQuery) (int64, error)

// type Update = {{ $.ParentPackageName }}.{{ $.Model.Name }}Update

type Extension = {{ $.ParentPackageName }}.{{ $.Model.Name }}Extension

// ConflictUpdate creates a custom ConflictAction for {{ $.Model.Name }} upsert conflicts in the hooks.
func ConflictUpdate(fn func(u *{{ $.ParentPackageName }}.{{ $.Model.Name }}Upsert)) *{{ $.ParentPackageName }}.ConflictAction {
	return {{ $.ParentPackageName }}.{{ $.Model.Name }}ConflictUpdate(fn)
}

